<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width">
<body style="font:14px sans-serif;padding:12px"><pre id="o" style="white-space:pre-wrap"></pre>
<script>
const U='https://script.google.com/macros/s/AKfycbwO13uHpPQ7WCOfhTqHGGQzTaVG43UL9pg8_8eoZu7nd3JKsNCTl2HCEfOITu2b8Jcz/exec';
const log=t=>o.textContent+=t+'\n';
function jp(n,url){window['cb'+n]=d=>log(n+' jsonp OK ยาว '+JSON.stringify(d).length);const s=document.createElement('script');s.onerror=()=>log(n+' jsonp ERR');s.src=url+'&callback=cb'+n;document.head.appendChild(s)}
async function T(n,sid){
 try{const r=await fetch(U+'?action=get&key=&sid='+encodeURIComponent(sid));const t=await r.text();
  log(n+' fetch sid='+sid+': ยาว '+t.length+' '+(t[0]==='{'?'JSON':'ไม่ใช่JSON: '+t.slice(0,80).replace(/\s+/g,' ')))}
 catch(e){log(n+' fetch sid='+sid+' ERR: '+e)}
 jp(n,U+'?action=get&key=&sid='+encodeURIComponent(sid));
}
(async()=>{
 const r=await fetch(U+'?action=get&key=&sid=');const d=(await r.json()).data;
 const st=d.students.find(s=>/กษิดิศ/.test(s.name))||d.students[0];
 log('นักเรียนที่ใช้ทดสอบ: '+st.name+' id='+st.id);
 await T('E',st.id);
 await T('F','s1');
})();
</script></body>
